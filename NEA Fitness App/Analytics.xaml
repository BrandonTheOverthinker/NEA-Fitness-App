<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NEAFitnessApp.Analytics"
             Title="Analytics">
    <VerticalStackLayout
        Padding="30,0"
        Spacing="35">
        <Label 
            Text="Workout Stats"
            Style="{StaticResource Headline}" />
        <Label 
            Text="Macronutrient Stats"
            Style="{StaticResource Headline}" />
        <Label 
            Text="Goal Progress"
            Style="{StaticResource Headline}" />
        <Grid ColumnDefinitions="*,*,*">
            <Label
                Text="Body Weight Goal"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                Grid.Column="0"/>
            <Label
                Text="Nutrition Goal"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                Grid.Column="1"/>
            <Label
                Text="Exercise Goal"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                Grid.Column="2"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>