<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NEAFitnessApp.WorkoutLog"
    Title="Workout Log">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <Label
                Text="Workout Log"
                Style="{StaticResource Headline}" />

            <!-- My Exercise Library header row: -->
            <Grid
                ColumnDefinitions="*,Auto">
                <Label
                    Text="My Exercises"
                    Style="{StaticResource SubHeadline}"
                    Grid.Column="0" />
                <Button
                    Text="+ New Exercise"
                    FontSize="13"
                    Padding="0"
                    Grid.Column="1"
                    Clicked="OnCreateExerciseClicked" />
            </Grid>

            <!-- Search bar for personal library: -->
            <SearchBar
                x:Name="ExerciseSearchBar"
                Placeholder="Search exercises..."
                TextChanged="OnSearchTextChanged" />

            <!-- Personal library list: -->
            <CollectionView
                x:Name="ExerciseLibraryView"
                HeightRequest="260"
                EmptyView="No exercises yet. Create one above.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Margin="0,3">
                            <Grid
                                ColumnDefinitions="*,Auto">
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="2">
                                    <Label
                                        Text="{Binding ExerciseName}"
                                        FontSize="15"
                                        FontAttributes="Bold" />
                                    <Label
                                        Text="{Binding ExerciseType}"
                                        FontSize="12" />
                                </VerticalStackLayout>
                                <Button
                                    Text="History"
                                    Grid.Column="1"
                                    FontSize="12"
                                    Padding="4,0"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnViewHistoryClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView
                HeightRequest="1"
                Margin="0,8" />

            <!-- Start Workout section: -->
            <Label
                Text="Start a Workout"
                Style="{StaticResource SubHeadline}" />

            <VerticalStackLayout
                Spacing="10">
                <Label
                    Text="Workout Name"
                    FontSize="14" />
                <Entry
                    x:Name="WorkoutNameEntry"
                    Placeholder="e.g. Push Day"
                    MaxLength="100" />
            </VerticalStackLayout>

            <VerticalStackLayout
                Spacing="10">
                <Label
                    Text="Notes (optional)"
                    FontSize="14" />
                <Entry
                    x:Name="WorkoutNotesEntry"
                    Placeholder="Any notes..."
                    MaxLength="500" />
            </VerticalStackLayout>

            <Label
                x:Name="StartErrorLabel"
                FontSize="13"
                IsVisible="False" />

            <Button
                Text="Start Workout"
                CornerRadius="8"
                Clicked="OnStartWorkoutClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>