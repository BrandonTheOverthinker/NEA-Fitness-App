<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NEA_Fitness_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NEA_Fitness_App"
    Shell.FlyoutBehavior="Flyout"
    Title="NEA_Fitness_App">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Food Log"
        ContentTemplate="{DataTemplate local:FoodLog}"
        Route="FoodLog" />
    <ShellContent
        Title="Workout Log"
        ContentTemplate="{DataTemplate local:WorkoutLog}"
        Route="WorkoutLog" />
    <ShellContent
        Title="Analytics"
        ContentTemplate="{DataTemplate local:Analytics}"
        Route="Analytics" />
    <ShellContent
        Title="Goals"
        ContentTemplate="{DataTemplate local:Goals}"
        Route="Goals" />
    <ShellContent
        Title="Settings"
        ContentTemplate="{DataTemplate local:Settings}"
        Route="Settings" />

</Shell>
