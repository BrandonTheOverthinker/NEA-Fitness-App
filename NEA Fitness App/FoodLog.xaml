<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NEAFitnessApp.Models"
             x:Class="NEAFitnessApp.FoodLog"
             Title="Food Log &amp; Nutrition"
             BackgroundColor="{StaticResource Secondary}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="20">

            <Border StrokeThickness="1"
                    Stroke="{StaticResource Primary}"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Daily Intake Summary"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*, *, *, *"
                          RowDefinitions="Auto, Auto">
                        <Label Text="Calories"
                               Grid.Column="0"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TotalCalories, StringFormat='{0} kcal'}"
                               Grid.Row="1"
                               Grid.Column="0"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />

                        <Label Text="Protein"
                               Grid.Column="1"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TotalProtein, StringFormat='{0}g'}"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />

                        <Label Text="Carbs"
                               Grid.Column="2"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TotalCarbs, StringFormat='{0}g'}"
                               Grid.Row="1"
                               Grid.Column="2"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />

                        <Label Text="Fat"
                               Grid.Column="3"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TotalFat, StringFormat='{0}g'}"
                               Grid.Row="1"
                               Grid.Column="3"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Primary}"
                             Margin="0,10" />

                    <Grid ColumnDefinitions="*, *"
                          RowDefinitions="Auto, Auto">
                        <Label Text="7-Day Avg"
                               Grid.Column="0"
                               HorizontalOptions="Center"
                               FontSize="12" />
                        <Label Text="{Binding WeeklyAverageDisplay, StringFormat='{0} kcal'}"
                               Grid.Row="1"
                               Grid.Column="0"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Database Management"
                   FontSize="18"
                   FontAttributes="Bold" />
            <Border Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Entry x:Name="NewFoodNameEntry"
                           Placeholder="Food Name" />
                    <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                          ColumnSpacing="10">
                        <Entry x:Name="NewFoodCalsEntry"
                               Placeholder="Calories (kcal)"
                               Keyboard="Numeric"
                               Grid.Column="0" />
                        <Entry x:Name="NewFoodProteinEntry"
                               Placeholder="Protein (g)"
                               Keyboard="Numeric"
                               Grid.Column="1" />
                        <Entry x:Name="NewFoodFatEntry"
                               Placeholder="Fat (g)"
                               Keyboard="Numeric"
                               Grid.Column="2" />
                        <Entry x:Name="NewFoodSatFatEntry"
                               Placeholder="Saturated Fat (g)"
                               Keyboard="Numeric"
                               Grid.Column="3" />
                        <Entry x:Name="NewFoodCarbEntry"
                               Placeholder="Carbohydrates (g)"
                               Keyboard="Numeric"
                               Grid.Column="4" />
                        <Entry x:Name="NewFoodSugarEntry"
                               Placeholder="Sugar (g)"
                               Keyboard="Numeric"
                               Grid.Column="5" />
                        <Entry x:Name="NewFoodFibreEntry"
                               Placeholder="Fibre (g)"
                               Keyboard="Numeric"
                               Grid.Column="6" />
                    </Grid>
                    <Button Text="Add to Database"
                            Clicked="OnCreateFoodClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Log at:"
                       VerticalOptions="Center"
                       FontAttributes="Bold" />
                <DatePicker x:Name="LogDatePicker"
                            Format="dd-mm-yyyy"
                            DateSelected="OnDateSelected" />
                <TimePicker x:Name="LogTimePicker"/>
                <Entry x:Name="QuantityEntry"
                       Placeholder="Quantity"
                       Keyboard="Numeric"
                       MaxLength="16" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="2*,*,*,*,*,*,*,*,*,*"
                  Padding="8"
                  BackgroundColor="{StaticResource Primary}">
                <Label Text="Name"
                       TextColor="White"
                       HorizontalOptions="Center"
                       FontAttributes="Bold" />
                <Label Text="Calories"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="1" />
                <Label Text="Protein"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="2" />
                <Label Text="Fat"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="3" />
                <Label Text="Saturated Fat"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="4" />
                <Label Text="Carbohydrates"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="5" />
                <Label Text="Sugar"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="6" />
                <Label Text="Fibre"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="7" />
                <Label Text="Quantity"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="8" />
                <Label Text="Time"
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Grid.Column="9" />
            </Grid>

            <CollectionView ItemsSource="{Binding DailyLogs}"
                            HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodLogEntry">
                        <Grid ColumnDefinitions="2*,*,*,*,*,*,*,*,*,*"
                              Padding="8">
                            <Label Text="{Binding FoodItem.FoodName}" />
                            <Label Text="{Binding FoodItem.Calories, StringFormat='{}{0} kcal'}"
                                   HorizontalOptions="Center"
                                   Grid.Column="1" />
                            <Label Text="{Binding FoodItem.Protein, StringFormat='{}{0} g'}"
                                   HorizontalOptions="Center"
                                   Grid.Column="2" />
                            <Label Text="{Binding FoodItem.Fat, StringFormat='{}{0} g'}"
                                   HorizontalOptions="Center"
                                   Grid.Column="3" />
                            <Label Text="{Binding FoodItem.SaturatedFat, StringFormat='{}{0} g'}"
                                   HorizontalOptions="Center"
                                   Grid.Column="4" />
                            <Label Text="{Binding FoodItem.Carbohydrates, StringFormat='{}{0} g'}"
                                   HorizontalOptions="Center"
                                   Grid.Column="5" />
                            <Label Text="{Binding FoodItem.Sugar, StringFormat='{}{0} g'}"
                                   HorizontalOptions="Center"
                                   Grid.Column="6" />
                            <Label Text="{Binding FoodItem.Fibre, StringFormat='{}{0} g'}"
                                   HorizontalOptions="Center"
                                   Grid.Column="7" />
                            <Label Text="{Binding Quantity}"
                                   HorizontalOptions="Center"
                                   Grid.Column="8" />
                            <Label Text="{Binding LogTime, StringFormat='{0:HH:mm}'}"
                                   HorizontalOptions="Center"
                                   Grid.Column="9" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Food Database (Sorted A-Z)"
                   FontSize="18"
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding AllFoodsDB}"
                            HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodItem">
                        <Border Margin="0,0,0,8"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding FoodName}"
                                           FontAttributes="Bold" />
                                    <Label TextColor="DimGray"
                                           FontSize="12">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} kcal | P {1}g | F {2}g | C {3}g">
                                                <Binding Path="Calories" />
                                                <Binding Path="Protein" />
                                                <Binding Path="Fat" />
                                                <Binding Path="Carbohydrates" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Button Text="Log"
                                        Grid.Column="1"
                                        Clicked="OnLogFoodClicked"
                                        CommandParameter="{Binding .}"
                                        HeightRequest="36"
                                        Padding="10,0"
                                        FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>