<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NEAFitnessApp.ActiveWorkoutPage"
    Title="Active Workout">

    <Shell.BackButtonBehavior>
        <!-- Prevent accidental back-navigation mid-workout: -->
        <BackButtonBehavior
            IsVisible="False"
            IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16">

            <!-- Header: workout name + timer -->
            <Grid
                ColumnDefinitions="*,Auto">
                <Label
                    x:Name="WorkoutNameLabel"
                    Text="Workout"
                    Style="{StaticResource Headline}"
                    Grid.Column="0" />
                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="End">
                    <Label
                        Text="Duration"
                        FontSize="12"
                        HorizontalTextAlignment="Center" />
                    <Label
                        x:Name="TimerLabel"
                        Text="00:00"
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Logged exercises list -->
            <CollectionView
                x:Name="ExercisesCollectionView"
                SelectionMode="Single"
                SelectionChanged="OnExerciseSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Margin="0,4">
                            <VerticalStackLayout
                                Spacing="4">
                                <Label
                                    Text="{Binding ExerciseName}"
                                    FontSize="16"
                                    FontAttributes="Bold" />
                                <Label
                                    Text="{Binding SetSummary}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Text="+ Add Exercise"
                CornerRadius="8"
                Clicked="OnAddExerciseClicked" />

            <!-- Set Logger (shown after selecting an exercise) -->
            <Border
                x:Name="SetLoggerFrame"
                StrokeShape="RoundRectangle 10"
                Padding="16"
                IsVisible="False">

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        x:Name="SelectedExerciseLabel"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <!-- Strength fields (weight + reps) -->
                    <VerticalStackLayout
                        x:Name="StrengthFields"
                        Spacing="10"
                        IsVisible="False">
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4">
                                <Label
                                    Text="Weight (kg)"
                                    FontSize="13" />
                                <Entry
                                    x:Name="WeightEntry"
                                    Placeholder="0.0"
                                    Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4">
                                <Label
                                    Text="Reps"
                                    FontSize="13" />
                                <Entry
                                    x:Name="RepsEntry"
                                    Placeholder="0"
                                    Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Cardio fields (distance + time) -->
                    <VerticalStackLayout
                        x:Name="CardioFields"
                        Spacing="10"
                        IsVisible="False">
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">
                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4">
                                <Label
                                    Text="Distance (m)"
                                    FontSize="13" />
                                <Entry
                                    x:Name="DistanceEntry"
                                    Placeholder="0"
                                    Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="4">
                                <Label
                                    Text="Time (seconds)"
                                    FontSize="13" />
                                <Entry
                                    x:Name="TimeEntry"
                                    Placeholder="0"
                                    Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Label
                        x:Name="SetErrorLabel"
                        FontSize="13"
                        IsVisible="False" />

                    <Button
                        Text="Log Set"
                        CornerRadius="8"
                        Clicked="OnLogSetClicked" />
                    
                    <!-- Rest Timer Panel (shown automatically after a set is logged) -->
                    <Border
                        x:Name="RestTimerPanel"
                        Padding="16"
                        IsVisible="false">
                        <VerticalStackLayout
                            Spacing="10">
                            <Label
                                x:Name="RestTimer"
                                Text="Rest Timer"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                IsVisible="False"/>
                            <Label
                                x:Name="RestTimerLabel"
                                Text="00:00"
                                FontSize="36"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"/>
                            <Button
                                Text="Skip Rest"
                                Clicked="OnSkipRestClicked"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Border>
            
            <Button
                Text="Finish Workout"
                CornerRadius="8"
                Margin="0,16,0,0"
                Clicked="OnFinishWorkoutClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>