<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NEAFitnessApp.CreateWeightGoalPage"
             Title="Create Goal"
             BackgroundColor="{StaticResource Secondary}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label x:Name="PageTitle"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Goal Description:"
                   FontAttributes="Bold" />
            <Entry x:Name="DescriptionEntry"
                   Placeholder="e.g., Lose weight for summer" />

            <Label Text="Start Weight (kg):"
                   FontAttributes="Bold" />
            <Entry x:Name="StartWeightEntry"
                   Placeholder="Current weight"
                   Keyboard="Numeric" />

            <Label Text="Target Weight (kg):"
                   FontAttributes="Bold" />
            <Entry x:Name="TargetWeightEntry"
                   Placeholder="Goal weight"
                   Keyboard="Numeric" />

            <Label Text="Deadline:"
                   FontAttributes="Bold" />
            <DatePicker x:Name="DeadlinePicker"
                        Format="dd/MM/yyyy" />

            <Button Text="Create Goal"
                    Clicked="OnCreateClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Padding="20,15"
                    FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>