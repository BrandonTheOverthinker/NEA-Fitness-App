<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NEAFitnessApp.ExerciseHistoryPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16">

            <Label
                x:Name="PageTitleLabel"
                Style="{StaticResource Headline}" />

            <!-- Chart placeholder - a simple visual bar chart drawn with BoxViews.
                 For a proper chart, plug in OxyPlot.Maui or Microcharts.Maui: -->
            <Border
                StrokeShape="RoundRectangle 10"
                Padding="16"
                HeightRequest="200">
                <VerticalStackLayout
                    Spacing="8">
                    <Label
                        Text="Max Weight Per Session"
                        FontSize="13" />
                    <ScrollView
                        Orientation="Horizontal">
                        <HorizontalStackLayout
                            x:Name="ChartBarsLayout"
                            Spacing="8"
                            VerticalOptions="End" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <!-- History table: -->
            <Label
                Text="Session History"
                Style="{StaticResource SubHeadline}" />

            <!-- Column headers: -->
            <Grid
                ColumnDefinitions="*,*,*,*"
                Padding="4,0">
                <Label
                    Text="Date"
                    FontSize="12"
                    Grid.Column="0" />
                <Label
                    Text="Sets"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Grid.Column="1" />
                <Label
                    Text="Best Set"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    Grid.Column="2" />
                <Label
                    Text="Vol (kg)"
                    FontSize="12"
                    HorizontalTextAlignment="End"
                    Grid.Column="3" />
            </Grid>

            <BoxView
                HeightRequest="1" />

            <!-- Table rows: -->
            <CollectionView
                x:Name="HistoryTableView"
                EmptyView="No history yet for this exercise.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            Padding="4,8">
                            <Label
                                Text="{Binding DateStr}"
                                FontSize="13"
                                Grid.Column="0" />
                            <Label
                                Text="{Binding SetCount}"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                Grid.Column="1" />
                            <Label
                                Text="{Binding BestSet}"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                Grid.Column="2" />
                            <Label
                                Text="{Binding TotalVolume}"
                                FontSize="13"
                                HorizontalTextAlignment="End"
                                Grid.Column="3" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>