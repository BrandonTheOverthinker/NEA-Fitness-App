<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NEAFitnessApp.ExerciseHistoryPage"
             BackgroundColor="#212121">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                x:Name="PageTitleLabel"
                Style="{StaticResource Headline}" />

            <!-- Chart placeholder: a simple visual bar chart drawn with BoxViews -->
            <!-- For a proper chart, plug in OxyPlot.Maui or Microcharts.Maui -->
            <Frame
                BackgroundColor="#2E2E2E"
                CornerRadius="10" Padding="16"
                HeightRequest="200">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Max Weight Per Session"
                        TextColor="#AAAAAA"
                        FontSize="13"/>
                    <ScrollView
                        Orientation="Horizontal">
                        <HorizontalStackLayout
                            x:Name="ChartBarsLayout"
                            Spacing="8"
                            VerticalOptions="End"/>
                    </ScrollView>
                </VerticalStackLayout>
            </Frame>

            <!-- History table -->
            <Label
                Text="Session History"
                Style="{StaticResource SubHeadline}"/>

            <!-- Column headers -->
            <Grid
                ColumnDefinitions="*,*,*,*"
                Padding="4,0">
                <Label
                    Text="Date"
                    TextColor="#AAAAAA"
                    FontSize="12"
                    Grid.Column="0"/>
                <Label 
                    Text="Sets" 
                    TextColor="#AAAAAA" 
                    FontSize="12" 
                    Grid.Column="1" 
                    HorizontalTextAlignment="Center"/>
                <Label 
                    Text="Best Set" 
                    TextColor="#AAAAAA" 
                    FontSize="12" 
                    Grid.Column="2" 
                    HorizontalTextAlignment="Center"/>
                <Label 
                    Text="Vol (kg)" 
                    TextColor="#AAAAAA" 
                    FontSize="12" 
                    Grid.Column="3" 
                    HorizontalTextAlignment="End"/>
            </Grid>
            <BoxView 
                HeightRequest="1" 
                Color="#333333"/>

            <!-- Table rows -->
            <CollectionView 
                x:Name="HistoryTableView"
                EmptyView="No history yet for this exercise.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            Padding="4,8">
                            <Label
                                Text="{Binding DateStr}"
                                TextColor="White"
                                FontSize="13"
                                Grid.Column="0"/>
                            <Label
                                Text="{Binding SetCount}"
                                TextColor="White"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                Grid.Column="1"/>
                            <Label
                                Text="{Binding BestSet}"
                                TextColor="#4CAF50"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                Grid.Column="2"/>
                            <Label
                                Text="{Binding TotalVolume}"
                                TextColor="White"
                                FontSize="13"
                                HorizontalTextAlignment="End"
                                Grid.Column="3"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
