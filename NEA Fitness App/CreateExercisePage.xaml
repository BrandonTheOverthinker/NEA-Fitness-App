<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NEAFitnessApp.CreateExercisePage"
    Title="New Exercise">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <Label
                Text="Create Exercise"
                Style="{StaticResource Headline}" />

            <Label
                Text="This exercise will be added to the global library for all users, and to your personal library."
                FontSize="13" />

            <!-- Exercise Name: -->
            <VerticalStackLayout
                Spacing="6">
                <Label
                    Text="Exercise Name"
                    FontSize="14" />
                <Entry
                    x:Name="ExerciseNameEntry"
                    Placeholder="e.g. Bench Press"
                    MaxLength="50" />
            </VerticalStackLayout>

            <!-- Exercise Type: -->
            <VerticalStackLayout
                Spacing="6">
                <Label
                    Text="Exercise Type"
                    FontSize="14" />
                <Picker
                    x:Name="ExerciseTypePicker"
                    SelectedIndexChanged="OnExerciseTypeChanged">
                    <Picker.Items>
                        <x:String>Strength</x:String>
                        <x:String>Cardio</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <!-- Type hint - updates based on picker selection: -->
            <Label
                x:Name="TypeHintLabel"
                FontSize="13"
                IsVisible="False" />

            <!-- Error message: -->
            <Label
                x:Name="ErrorLabel"
                FontSize="13"
                IsVisible="False" />

            <!-- Save Button: -->
            <Button
                Text="Save Exercise"
                CornerRadius="8"
                Margin="0,10,0,0"
                Clicked="OnSaveClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>