<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NEAFitnessApp.RegistrationPage"
             Title="Create Account">
    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="10">
            <Label
                Text="Tell us about yourself"
                Style="{StaticResource Headline}" />

            <Entry
                x:Name="UsernameEntry"
                Placeholder="Username" />
            <Entry
                x:Name="PasswordEntry"
                Placeholder="Password" IsPassword="True" />

            <Grid ColumnDefinitions="*,*,*, *" ColumnSpacing="10" RowDefinitions="*,*" RowSpacing="5">
                <Label
                    Text="Weight (Kg)"
                    HorizontalOptions="Center"
                    Grid.Column="0"
                    Grid.Row="0" />
                <Entry
                    x:Name="WeightEntry"
                    Grid.Column="0"
                    Grid.Row="1"
                    WidthRequest="120"
                    Placeholder="000.0"
                    Keyboard="Numeric"
                    TextChanged="OnMetricsChanged" />
                <Label
                    Text="Height (Cm)"
                    HorizontalOptions="Center"
                    Grid.Column="1"
                    Grid.Row="0" />
                <Entry
                    x:Name="HeightEntry"
                    Grid.Column="1"
                    Grid.Row="1"
                    WidthRequest="120"
                    Placeholder="000.0"
                    Keyboard="Numeric"
                    TextChanged="OnMetricsChanged" />
                <Label
                    Text="Select Gender"
                    HorizontalOptions="Center"
                    Grid.Column="2"
                    Grid.Row="0" />
                <Picker
                    x:Name="GenderPicker" 
                    Grid.Column="2"
                    Grid.Row="1" 
                    SelectedIndexChanged="OnMetricsChanged"
                    WidthRequest="120">
                    <Picker.Items>
                        <x:String>Male</x:String>
                        <x:String>Female</x:String>
                        <x:String>Prefer not to say</x:String>
                    </Picker.Items>
                </Picker>
                <Label
                    Text="Date of Birth"
                    Grid.Column="3"
                    Grid.Row="0"
                    HorizontalOptions="Center" />
                <DatePicker
                    x:Name="DobPicker"
                    Grid.Column="3"
                    Grid.Row="1"
                    HorizontalOptions="Center"
                    DateSelected="OnMetricsChanged"
                    WidthRequest="120" />
            </Grid>

            <Grid ColumnDefinitions="*" ColumnSpacing="10" RowDefinitions="*,*,*,*,*,*,*" RowSpacing="5"
                  HorizontalOptions="Center" WidthRequest="500">
                <Label
                    Text="Activity Level"
                    Grid.Row="0"
                    Style="{StaticResource SubHeadline}"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Sedentary - little to no exercise in a day"
                    Grid.Row="1"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Lightly Active - light exercise 1-3 days/week"
                    Grid.Row="2"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Moderately Active - moderate exercise 3-5 days/week"
                    Grid.Row="3"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Very Active - hard exercise 6-7 days/week"
                    Grid.Row="4"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Extremely Active - very hard exercise/sports and physical job or 2x training"
                    Grid.Row="5"
                    HorizontalTextAlignment="Center" />
                <Picker
                    x:Name="ActivityPicker" 
                    Grid.Row="6"
                    Title="Select Activity Level" 
                    SelectedIndexChanged="OnMetricsChanged"
                    HorizontalOptions="Center"
                    WidthRequest="240">
                    <Picker.Items>
                        <x:String>BMR (Bedridden)</x:String>
                        <x:String>Sedentary</x:String>
                        <x:String>Lightly Active</x:String>
                        <x:String>Moderately Active</x:String>
                        <x:String>Very Active</x:String>
                        <x:String>Extremely Active</x:String>
                    </Picker.Items>
                </Picker>
            </Grid>

            <VerticalStackLayout HorizontalOptions="Center">
                <Label 
                    Text="Daily Maintenance Calories"
                    HorizontalOptions="Center"
                    FontSize="Header"/>
                <Label
                    x:Name="BmrDisplay"
                    Text="0.0"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    FontSize="Large"/>
            </VerticalStackLayout>

            <Button
                Text="Create Account"
                Clicked="OnFinaliseRegistrationClicked" />
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>